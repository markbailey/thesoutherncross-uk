{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": ".next/standalone",
    "rootDir": "."
  },
  "include": ["server.ts", "env.ts", "lib/**/*.ts", "types/**/*.d.ts"],
  "exclude": [
    "node_modules", ".next",
    "**/*.test.ts",
    "app/**", "components/**", "config/**", "scripts/**"
  ]
}
