# Steam Web API key — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Steam group vanity URL (e.g. "southerncrossuk") or 64-bit id
STEAM_GROUP_ID=

# Secret required by /api/refresh — sent in the `x-refresh-secret` header
REFRESH_SECRET=

# SQLite file path (defaults to ./data/app.sqlite if unset)
DATABASE_URL=./data/app.sqlite

# Public base URL — must use the canonical hostname (www. if the apex→www
# redirect is active in web.config). Used to build the Steam OpenID
# callback URL and redirect origins. Example: https://www.thesoutherncross.uk
SITE_BASE_URL=https://www.thesoutherncross.uk

# Node bind port (default 3000)
PORT=3000

# Log level: trace | debug | info | warn | error (default info)
LOG_LEVEL=info

# Set to 1 only when a trusted reverse proxy (e.g. IIS in production) sits in
# front of Node and rewrites X-Forwarded-For / X-Real-IP. Leave unset in dev:
# rate-limit buckets fall back to a single "unknown" key, so /api/refresh stays
# rate-limited even if a caller forges the headers. Phase 5 deploy enables this.
# TRUST_PROXY_HEADERS=1
