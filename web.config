<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site config for thesoutherncross.uk

  This file lives in the IIS site root (C:\inetpub\thesoutherncross-uk).
  IIS terminates TLS on 443 and reverse-proxies to the Next.js custom server
  on http://127.0.0.1:3000 via URL Rewrite + Application Request Routing.

  Sections (in order):
    1. Cache  - long-cache /_next/static/*, no-store /api/*
    2. Security headers - HSTS, CSP, etc.
    3. Rewrite - HTTPS redirect + reverse proxy
    4. Proxy preserveHostHeader - so Node sees original Host

  Operator notes:
    - ARR proxy must be enabled globally (set by install-prereqs.ps1).
    - Do NOT inline secrets here; .env at site root is read by the Node process.
    - If you change the Node bind port, update the rewrite action URL below.
-->
<configuration>

  <system.webServer>

    <!-- ===================================================================
         1. CACHE
         =================================================================== -->
    <!-- Default: no clientCache header on the site root - the proxied Next.js
         responses already carry their own Cache-Control. We only override
         in the explicit <location> blocks at the bottom of this file. -->

    <!-- ===================================================================
         2. SECURITY HEADERS
         ===================================================================
         Applied to every response. CSP is strict but allows Steam avatar
         CDNs for img-src and 'unsafe-inline' for style-src (R3F + Next
         emit some inline styles). connect-src is self-only because all
         SWR endpoints are same-origin. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains; preload" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="interest-cohort=()" />
        <!-- script-src needs 'unsafe-inline' for Next.js 16 hydration bootstrap.
             Per-request nonces would be tighter but require app-side middleware,
             which IIS at this layer can't generate. -->
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data: https://*.akamaihd.net https://*.steamstatic.com; connect-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>

    <!-- ===================================================================
         3. REWRITE
         ===================================================================
         Three rules in priority order:
           a) Redirect bare apex -> www subdomain (canonical: www.thesoutherncross.uk)
           b) Redirect plain HTTP -> HTTPS (301)
           c) Reverse-proxy everything else to the Node server on :3000
         Both redirect rules preserve original client info via X-Forwarded-*
         headers so the Node app (with TRUST_PROXY_HEADERS=1) sees the real IP. -->
    <rewrite>
      <rules>

        <!-- (a) Apex -> www canonical redirect.
             Fires for both http and https on the bare apex. Combined with
             rule (b)'s HTTPS upgrade this means apex/HTTP traffic does ONE
             redirect (to https://www) rather than two. -->
        <rule name="Apex to www redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^thesoutherncross\.uk$" />
          </conditions>
          <action type="Redirect"
                  url="https://www.thesoutherncross.uk/{R:1}"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <!-- (b) HTTP -> HTTPS redirect.
             Matches when HTTPS is off. {HTTP_HOST} is preserved so this
             works for any hostname IIS is bound to. 301 permanent. -->
        <rule name="HTTP to HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect"
                  url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <!-- (c) Reverse proxy to Node.
             stopProcessing="true" so no further rules run.
             appendQueryString="true" preserves ?q=... in the proxied URL.
             serverVariables push the original client info into the
             upstream request so Node sees the real Host / IP / scheme. -->
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite"
                  url="http://127.0.0.1:3000/{R:1}"
                  appendQueryString="true" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <!-- Preserve any upstream X-Forwarded-For chain (e.g. behind a CDN later)
                 by appending REMOTE_ADDR rather than replacing. -->
            <set name="HTTP_X_FORWARDED_FOR" value="{HTTP_X_FORWARDED_FOR}, {REMOTE_ADDR}" />
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>

      </rules>
    </rewrite>

    <!-- preserveHostHeader sends the original Host: header upstream to Node.
         Required for Next.js absolute-URL generation and any host-aware code. -->
    <proxy enabled="true" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false" />

    <!-- Allow Server: header from upstream to be hidden by IIS if desired.
         (We don't strip it explicitly here - Node sets none of consequence.) -->

  </system.webServer>

  <!-- ===================================================================
       4. PER-PATH CACHE OVERRIDES
       ===================================================================
       These mirror what the Next app already emits, but we set them at the
       proxy boundary as a belt-and-braces guard. -->

  <!-- /_next/static/* - immutable hashed assets, cache hard. -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- /api/* - never cache. The Next API routes already set this via
       jsonNoStore; we mirror it here in case a route ever forgets to. -->
  <location path="api">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-store" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>
